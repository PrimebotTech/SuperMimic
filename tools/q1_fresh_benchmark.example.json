    "fuse_model_loss": true,
    "cache_reference_heads": true,
    "cache_goals": true,
    "capture_reset": true,
    "runtime_checks": "per_update",
    "clean_policy_actions": true,
    "action_lag": false,
    "normalize_policy_objective": true,
    "normalize_model_objective": true,
    "reward_arm_joint_weight": 0.05,
    "reward_arm_pd_target_weight": 0.0,
    "save_interval": 5000,
    "initial_save_iteration": 100,
    "profile_every": 10,
    "checkpoint_replay": false,
    "resume_replay": true,
    "collective_timeout_seconds": 1800,
    "seed": 0,
    "capture_imagination": true,
    "compile_critic": false,
    "fused_optimizers": false,
    "iterations": 250000
