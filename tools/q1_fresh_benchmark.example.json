{
  "project_dir": ".",
  "benchmark_root": "logs/q1_fresh_benchmarks",
  "run_root": "logs/q1_fresh",
  "original_run_root": "logs/q1_previous",
  "checkpoint": null,
  "source_iteration": 0,
  "benchmark_updates": 120,
  "benchmark_warmup_updates": 20,
  "benchmark_timeout_seconds": 2400,
  "gpu_ids": "0,1,2,3,4,5,6,7",
  "cpu_affinity": {},
  "environment": {
    "PYTHONPATH": "src",
    "PYTHONUNBUFFERED": "1",
    "OMP_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1"
  },
  "train": {
    "robot_xml": "assets/q1_v2/xml/q1_v2_mc.xml",
    "motion_dir": "data/q1_motion_library_filtered",
    "motion_pattern": "*/*.npz",
    "max_motions": 0,
    "motion_memory_gb": 16.0,
    "motion_storage": "device-fp16",
    "device": "cuda:0",
    "num_envs": 8192,
    "model_batch_size": 4096,
    "policy_batch_size": 4096,
    "replay_steps": 1000,
    "model_batches": 10,
    "critic_epochs": 5,
