"""The passive viewer handle, as this project drives it."""

from typing import Any

from mujoco import MjData, MjModel, MjvScene

class Handle:
  user_scn: MjvScene
  def is_running(self) -> bool: ...
  def sync(self) -> None: ...
  def close(self) -> None: ...
  def __enter__(self) -> Handle: ...
  def __exit__(self, *args: Any) -> None: ...

def launch_passive(model: MjModel, data: MjData) -> Handle: ...
